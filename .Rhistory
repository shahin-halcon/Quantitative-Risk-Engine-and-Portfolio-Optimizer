# 1. Install & Load Libraries
install.packages(c("tidyquant", "tidyverse", "PerformanceAnalytics"))
library(tidyquant)
library(tidyverse)
library(PerformanceAnalytics)
# 2. Define Tickers & Fetch Live API Data
tickers <- c("AAPL", "MSFT", "NVDA", "AMZN", "GOOGL")
# Pulls price history directly from Yahoo Finance up to today's date
live_stock_data <- tq_get(
tickers,
get = "stock.prices",
from = "2023-01-01",
to = Sys.Date()
)
# 1. Install & Load Libraries
# (Run the install line once if you don't have yfR)
install.packages(c("yfR", "tidyverse", "tidyquant", "PerformanceAnalytics"))
library(yfR)
library(tidyverse)
library(tidyquant)
library(PerformanceAnalytics)
# 2. Define Tickers
tickers <- c("AAPL", "MSFT", "NVDA", "AMZN", "GOOGL")
live_stock_data <- yf_get(
tickers = tickers,
first_date = "2023-01-01",
last_date = Sys.Date()
)
View(live_stock_data)
# 4. Standardize the columns so it perfectly matches our risk engine
live_stock_data <- live_stock_data %>%
select(symbol = ticker, date = ref_date, adjusted = price_adjusted)
# 5. Calculate Daily Log Returns
stock_returns <- live_stock_data %>%
group_by(symbol) %>%
tq_transmute(
select = adjusted,
mutate_fun = periodReturn,
period = "daily",
type = "log",
col_rename = "daily_return"
)
# 5. Calculate Daily Log Returns (Pure dplyr - No extra dependencies required)
stock_returns <- live_stock_data %>%
group_by(symbol) %>%
arrange(date) %>%
mutate(daily_return = log(adjusted / lag(adjusted))) %>%
drop_na(daily_return) # Remove the first row per stock where lag() is NA
# 6. Compute Financial Risk Metrics
portfolio_risk_summary <- stock_returns %>%
group_by(symbol) %>%
summarise(
avg_daily_return = mean(daily_return, na.rm = TRUE),
annualized_return = (1 + avg_daily_return)^252 - 1,
annualized_volatility = sd(daily_return, na.rm = TRUE) * sqrt(252),
sharpe_ratio = annualized_return / annualized_volatility,
var_95 = quantile(daily_return, 0.05, na.rm = TRUE)
) %>%
arrange(desc(sharpe_ratio))
# Print the risk metrics summary to console
print(portfolio_risk_summary)
View(portfolio_risk_summary)
library(ggplot2)
# 1. Cumulative Growth Plot ($1 Investment Benchmark)
stock_returns %>%
group_by(symbol) %>%
mutate(growth = cumprod(1 + daily_return)) %>%
ggplot(aes(x = date, y = growth, color = symbol)) +
geom_line(linewidth = 1) +
theme_minimal() +
labs(
title = "Live Asset Growth Performance (Base = $1)",
subtitle = "Tracking historical performance from 2023 to present",
x = "Date",
y = "Portfolio Growth Multiplier ($)",
color = "Ticker"
)
# 1. Prepare time-series data with calculated cumulative growth
tableau_time_series <- stock_returns %>%
group_by(symbol) %>%
arrange(date) %>%
mutate(growth = cumprod(1 + daily_return)) %>%
ungroup()
# 2. Export both datasets to CSV files in your working directory
write.csv(tableau_time_series, "tableau_stock_time_series.csv", row_names = FALSE)
write.csv(tableau_time_series, "tableau_stock_time_series.csv", row_names = FALSE)
# 1. Prepare time-series data with calculated cumulative growth
tableau_time_series <- stock_returns %>%
group_by(symbol) %>%
arrange(date) %>%
mutate(growth = cumprod(1 + daily_return)) %>%
ungroup()
# 2. Export both datasets to CSV using tidyverse's write_csv
write_csv(tableau_time_series, "tableau_stock_time_series.csv")
write_csv(portfolio_risk_summary, "tableau_portfolio_risk_summary.csv")
cat("Successfully exported files for Tableau:\n",
"1. tableau_stock_time_series.csv\n",
"2. tableau_portfolio_risk_summary.csv\n")
library(tidyverse)
# 1. Create a Returns Matrix (Dates x Symbols)
returns_matrix <- stock_returns %>%
select(date, symbol, daily_return) %>%
pivot_wider(names_from = symbol, values_from = daily_return) %>%
select(-date) %>%
as.matrix()
# Compute mean daily returns and asset covariance
mean_returns <- colMeans(returns_matrix, na.rm = TRUE)
cov_matrix <- cov(returns_matrix, use = "complete.obs")
# 2. Setup Monte Carlo Engine
num_portfolios <- 10000
num_assets <- length(mean_returns)
# Pre-allocate containers for speed
portfolio_returns <- numeric(num_portfolios)
portfolio_volatility <- numeric(num_portfolios)
sharpe_ratios <- numeric(num_portfolios)
weights_matrix <- matrix(nrow = num_portfolios, ncol = num_assets)
colnames(weights_matrix) <- names(mean_returns)
set.seed(42) # For reproducible random sampling
# 3. Execute 10,000 Simulations
cat("Running 10,000 Monte Carlo Portfolio Simulations...\n")
for (i in 1:num_portfolios) {
# Generate random weights summing to 1 (100% allocation)
w <- runif(num_assets)
w <- w / sum(w)
weights_matrix[i, ] <- w
# Calculate annualized return
p_ret_daily <- sum(w * mean_returns)
portfolio_returns[i] <- (1 + p_ret_daily)^252 - 1
# Calculate annualized volatility using matrix multiplication
p_vol_annual <- sqrt(t(w) %*% cov_matrix %*% w) * sqrt(252)
portfolio_volatility[i] <- p_vol_annual
# Compute Sharpe Ratio
sharpe_ratios[i] <- portfolio_returns[i] / portfolio_volatility[i]
}
# 4. Combine Results into DataFrame
monte_carlo_results <- as_tibble(weights_matrix) %>%
mutate(
Expected_Return = portfolio_returns,
Annual_Risk = portfolio_volatility,
Sharpe_Ratio = sharpe_ratios
)
# 5. Extract Optimal Portfolio (Max Sharpe Ratio)
optimal_portfolio <- monte_carlo_results %>%
filter(Sharpe_Ratio == max(Sharpe_Ratio))
cat("\n==================================================\n")
cat("       OPTIMAL PORTFOLIO WEIGHT ALLOCATION        \n")
cat("==================================================\n")
print(pivot_longer(optimal_portfolio, cols = everything(), names_to = "Metric", values_to = "Value"))
# 6. Plot the Efficient Frontier
ggplot(monte_carlo_results, aes(x = Annual_Risk, y = Expected_Return, color = Sharpe_Ratio)) +
geom_point(alpha = 0.4, size = 0.8) +
geom_point(data = optimal_portfolio, aes(x = Annual_Risk, y = Expected_Return), color = "red", size = 5, shape = 18) +
scale_color_viridis_c(option = "plasma") +
theme_minimal() +
labs(
title = "Monte Carlo Efficient Frontier (10,000 Portfolio Scenarios)",
subtitle = "Red Diamond marks the mathematically optimal Max Sharpe Portfolio",
x = "Annualized Risk (Volatility)",
y = "Expected Annual Return",
color = "Sharpe Ratio"
)
